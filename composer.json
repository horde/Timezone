{
    "name": "horde/timezone",
    "description": "Timezone library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Timezone",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "olsen"
    ],
    "time": "2026-05-25",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/date": "^3 || dev-FRAMEWORK_6_0",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/icalendar": "^3 || dev-FRAMEWORK_6_0",
        "horde/vfs": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "pear/archive_tar": "^1.6",
        "psr/simple-cache": "^1 || ^2 || ^3"
    },
    "suggest": {
        "pear/archive_tar": "*",
        "psr/simple-cache": "^1 || ^2 || ^3",
        "ext-phar": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Timezone": "lib/"
        },
        "psr-4": {
            "Horde\\Timezone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Timezone\\Test\\": "test/",
            "Horde\\Timezone\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
    }
}